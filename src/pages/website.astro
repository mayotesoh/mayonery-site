---
import Layout from '../layouts/Layout.astro';
import { LINE_OFFICIAL_URL } from '../consts';

// 会員価格（fortunelabo会員向け）を表示するかどうか。false にすると一般価格だけになります。
const SHOW_MEMBER_PRICE = true;

const plans = [
    {
        name: 'ライト',
        pages: '1ページ',
        desc: 'プロフィール・活動内容・SNS・お問い合わせを1ページにまとめた、名刺代わりのサイト。まず名刺やSNSに載せるURLが欲しい方に。',
        price: 60000,
        member: 45000,
        featured: false,
    },
    {
        name: 'スタンダード',
        pages: '5ページまで',
        desc: 'トップ・プロフィール・サービス紹介・お問い合わせなど、5ページまで。サービスが複数ある方、実績や料金をきちんと見せたい方に。いちばん選ばれている構成です。',
        price: 100000,
        member: 70000,
        featured: true,
    },
    {
        name: 'フル',
        pages: '8ページまで＋ブログ',
        desc: '8ページまでの構成に、Notionで書くだけで更新できるブログ機能つき。事業が複数ある方、発信を続けたい方に。',
        price: 150000,
        member: 110000,
        featured: false,
    },
];

const required = [
    {
        name: '独自ドメイン 取得・接続',
        desc: 'ご希望のドメイン名の取得代行と、サイトへの接続設定。名義はご本人のままお渡しします。ドメイン代（年1,500円前後）は実費として別途かかります。',
        price: 8000,
        member: 6000,
    },
    {
        name: 'サイト維持費（初年度分）',
        desc: '公開後の維持・不具合対応の費用です。2年目以降も同額を毎年いただきます。',
        price: 12000,
        member: 12000,
    },
];

const options = [
    {
        name: 'ページ追加（制作時）',
        desc: '基本プランのページ数を超える分。最初にまとめて作る場合。1ページごと',
        price: 12000,
        member: 8000,
    },
    {
        name: 'ページ追加（公開後）',
        desc: '公開したあとで足す場合。既存ページとの調整・再確認・公開作業が別途かかるため、制作時より高くなります',
        price: 18000,
        member: 12000,
    },
    {
        name: 'Notionブログ連携',
        desc: 'Notionに書いて「公開」にするだけで記事が増える仕組み。記事一覧・カテゴリ絞り込み・キーワード検索・記事ページ・RSSまで一式。Notion側のデータベース作成と使い方のご案内込み',
        price: 25000,
        member: 18000,
    },
    {
        name: 'お問い合わせフォーム',
        desc: '送信された内容がメールで届く、シンプルな入力フォーム。項目は自由に決められます',
        price: 15000,
        member: 11000,
    },
    {
        name: '申込・予約フォーム',
        desc: '送信内容がNotion（またはスプレッドシート）に自動で溜まり、お客さまへの自動返信メールも送信。日時の選択と重複防止をつける場合は +¥10,000',
        price: 30000,
        member: 21000,
    },
    {
        name: '原稿づくりサポート',
        desc: 'ヒアリングして文章にします。1ページごと',
        price: 10000,
        member: 7000,
    },
    {
        name: 'アクセス解析の設置',
        desc: 'Googleアナリティクス・サーチコンソールの設定と、見方のご案内',
        price: 8000,
        member: 6000,
    },
];

const flow = [
    { no: '01', title: 'ご相談', text: 'どんなサイトにしたいか、公式LINEでうかがいます。' },
    { no: '02', title: 'お見積り', text: 'プランとオプションを決めて、金額を確定します。' },
    { no: '03', title: '素材のご用意', text: '写真と載せたい内容をお送りいただきます。' },
    { no: '04', title: '制作・ご確認', text: 'できあがった画面を見ていただき、直します。' },
    { no: '05', title: '公開', text: 'ドメインをつないで公開。更新の仕方もお伝えします。' },
];

const yen = (n: number) => `¥${n.toLocaleString('ja-JP')}`;
---

<Layout title="ホームページ制作 | 手相のマヨネリ">
    <div class="page-container container">

        <header class="page-header text-center">
            <h1 class="page-title">ホームページ制作</h1>
            <p class="page-desc">
                占い師・個人事業の方向けの、名刺代わりのホームページを制作します。<br>
                ページ数と機能で基本料金が決まり、必要なものだけオプションで足していく形です。
            </p>
            <a href={LINE_OFFICIAL_URL} target="_blank" rel="noopener noreferrer" class="yoyaku-banner">💬 公式LINEで相談する</a>
        </header>

        <section class="section">
            <h2 class="section-title">こんな方へ</h2>
            <div class="worries-grid">
                <div class="worry-card">
                    <span class="worry-icon">🪪</span>
                    <h3>名刺代わりが欲しい</h3>
                    <p>SNSだけでは伝わらない活動内容や実績を、ひとつのURLにまとめたい方。</p>
                </div>
                <div class="worry-card">
                    <span class="worry-icon">✍️</span>
                    <h3>自分で更新したい</h3>
                    <p>更新のたびに依頼するのではなく、Notionに書くだけで記事が増える形にしたい方。</p>
                </div>
                <div class="worry-card">
                    <span class="worry-icon">🌱</span>
                    <h3>少しずつ育てたい</h3>
                    <p>まず1ページから始めて、活動に合わせてページを足していきたい方。</p>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">基本プラン</h2>
            <p class="lead text-center">
                スマートフォン対応と、公式LINEへのお問い合わせ導線はすべて標準です。<br>
                あとから1ページずつ足すより、最初からまとまったプランを選ぶ方がお得です。
            </p>

            <div class="plan-list">
                {plans.map((p) => (
                    <div class:list={['plan-card', { featured: p.featured }]}>
                        <div class="plan-head">
                            <div>
                                <span class="plan-name">{p.name}</span>
                                <span class="plan-pages">{p.pages}</span>
                            </div>
                            <div class="plan-price">
                                <div class="p-main">
                                    <span class="p-label">一般</span>
                                    <span class="p-yen">{yen(p.price)}</span>
                                </div>
                                {SHOW_MEMBER_PRICE && (
                                    <div class="p-member">
                                        <span class="p-label">会員</span>
                                        <span class="p-yen">{yen(p.member)}</span>
                                    </div>
                                )}
                            </div>
                        </div>
                        <p class="plan-desc">{p.desc}</p>
                    </div>
                ))}
            </div>

            <p class="note text-center">
                例：ライト＋4ページ追加は108,000円。はじめからスタンダードなら100,000円です。
            </p>
        </section>

        <section class="section">
            <h2 class="section-title">制作時に必ずかかるもの</h2>
            <p class="lead text-center">サイトを公開するには、住所にあたる独自ドメインが必要です。基本プランに加えて、この2つがかかります。</p>

            <div class="row-list">
                {required.map((r) => (
                    <div class="row-item required">
                        <div class="row-body">
                            <span class="row-name">{r.name}</span>
                            <span class="row-desc">{r.desc}</span>
                        </div>
                        <div class="row-price">
                            <span class="rp-main">{yen(r.price)}</span>
                            {SHOW_MEMBER_PRICE && <span class="rp-member">会員 {yen(r.member)}</span>}
                        </div>
                    </div>
                ))}
            </div>

            <div class="example-box">
                <p>
                    <strong>お支払い例</strong>：スタンダード（5ページ）を会員価格でご依頼の場合<br>
                    70,000円 ＋ ドメイン6,000円 ＋ 維持費12,000円 ＝ <strong class="total">88,000円</strong>
                    <span class="ex-note">（＋ドメイン代の実費 年1,500円前後）</span>
                </p>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">オプション</h2>
            <p class="lead text-center">必要なものだけ、基本プランに追加できます。</p>

            <div class="row-list">
                {options.map((o) => (
                    <div class="row-item">
                        <div class="row-body">
                            <span class="row-name">{o.name}</span>
                            <span class="row-desc">{o.desc}</span>
                        </div>
                        <div class="row-price">
                            <span class="rp-main">{yen(o.price)}</span>
                            {SHOW_MEMBER_PRICE && <span class="rp-member">会員 {yen(o.member)}</span>}
                        </div>
                    </div>
                ))}
            </div>

            <p class="note text-center">
                フォームは必須ではありません。お問い合わせを公式LINEに一本化すれば、なくても困りません。
                「申し込み内容を記録として残したい」「日程を先に押さえたい」という場合にご検討ください。
            </p>
        </section>

        <section class="section">
            <h2 class="section-title">サイト維持費</h2>
            <p class="lead text-center">
                サイトは公開して終わりではなく、ドメインの更新やSSLの期限、連携先の仕様変更など、
                放っておくと表示できなくなる部分があります。そこを預かるための費用です。
            </p>

            <div class="row-list">
                <div class="row-item required">
                    <div class="row-body">
                        <span class="row-name">サイト維持費<span class="tag-req">必須</span></span>
                        <span class="row-desc">ドメイン・SSLの維持管理、表示トラブルの対応、連携している仕組み（ブログ・フォーム）の維持、軽微な修正（年3回まで）</span>
                    </div>
                    <div class="row-price"><span class="rp-main">¥12,000<span class="per">/ 年</span></span></div>
                </div>
                <div class="row-item">
                    <div class="row-body">
                        <span class="row-name">更新おまかせ<span class="tag-opt">任意</span></span>
                        <span class="row-desc">維持費の内容に加えて、記事の投稿代行（月2本まで）、内容の書き換え（月2回まで）</span>
                    </div>
                    <div class="row-price"><span class="rp-main">¥5,000<span class="per">/ 月</span></span></div>
                </div>
                <div class="row-item">
                    <div class="row-body">
                        <span class="row-name">スポット修正<span class="tag-opt">任意</span></span>
                        <span class="row-desc">維持費に含まれる年3回を超える修正、大きめの変更</span>
                    </div>
                    <div class="row-price"><span class="rp-main">¥3,000<span class="per">/ 回</span></span></div>
                </div>
            </div>

            <p class="note text-center">
                維持費の更新がない場合はサイトの管理を終了し、データはお渡しします。サイトをこちらで預かったままにすることはありません。
            </p>
        </section>

        <section class="section">
            <h2 class="section-title">基本プランに含まれるもの</h2>
            <div class="include-grid">
                <div class="include-card">
                    <h3>✓ 含まれます</h3>
                    <ul>
                        <li>デザイン・コーディング一式</li>
                        <li>スマートフォン・タブレット対応</li>
                        <li>公式LINE・SNSへの導線設置</li>
                        <li>お預かりした写真の配置と簡単な調整</li>
                        <li>公開作業（公開後の不具合対応は維持費に含まれます）</li>
                        <li>ご確認いただきながらの修正（公開前2回まで）</li>
                    </ul>
                </div>
                <div class="include-card excluded">
                    <h3>― 含まれません（別途）</h3>
                    <ul>
                        <li>ドメイン代・有料サービスの利用料（実費）</li>
                        <li>ロゴの制作・加工</li>
                        <li>写真撮影、素材写真の購入</li>
                        <li>原稿の執筆（オプションで承ります）</li>
                        <li>公開前の修正3回目以降（1回 ¥5,000）</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">ご依頼から公開まで</h2>
            <p class="lead text-center">目安は2〜4週間（原稿・写真のご用意次第）</p>
            <div class="flow-grid">
                {flow.map((f) => (
                    <div class="flow-card">
                        <span class="flow-no">STEP {f.no}</span>
                        <h3>{f.title}</h3>
                        <p>{f.text}</p>
                    </div>
                ))}
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">お支払い・その他</h2>
            <div class="notes-card">
                <p><strong>お支払い</strong>：着手時に半額、公開時に残額・ドメイン費用・初年度のサイト維持費をお振り込みください。</p>
                {SHOW_MEMBER_PRICE && (
                    <p><strong>会員価格</strong>：占いコミュニティ「fortunelabo」会員の方が対象です。ご紹介の場合も会員価格で承ります。</p>
                )}
                <p><strong>データのお渡し</strong>：サイトのデータはご本人のものです。ご希望があればいつでもお渡しします。</p>
                <p><strong>キャンセル</strong>：制作着手後のキャンセルは、着手金のご返金ができません。あらかじめご了承ください。</p>
                <p class="tax">表示価格はすべて税込です。内容によっては、この表に当てはまらないご相談もあります。まずはお気軽にどうぞ。</p>
            </div>
        </section>

        <section class="section cta-section text-center">
            <h2>まずはご相談ください</h2>
            <p>「何ページ必要かわからない」という状態で大丈夫です。<br>やりたいことをうかがって、合うプランをご提案します。</p>
            <a href={LINE_OFFICIAL_URL} target="_blank" rel="noopener noreferrer" class="cta-btn">公式LINEで相談する</a>
        </section>

    </div>
</Layout>

<style>
    .page-container { padding: 40px 0 80px; }
    .page-header { margin-bottom: 60px; }
    .page-title { font-size: 2rem; color: var(--color-primary); margin-bottom: 16px; }
    .page-desc { color: #47615a; line-height: 1.9; margin-bottom: 24px; }
    .text-center { text-align: center; }

    .yoyaku-banner {
        display: inline-block;
        background-color: var(--color-primary);
        color: #fff;
        text-decoration: none;
        padding: 12px 30px;
        border-radius: 999px;
        font-weight: bold;
        font-size: 0.95rem;
        box-shadow: 0 4px 0 #3c6253;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .yoyaku-banner:hover { transform: translateY(-2px); box-shadow: 0 6px 0 #3c6253; }

    .section { margin-bottom: 70px; }
    .section-title {
        font-size: 1.45rem;
        color: var(--color-primary);
        text-align: center;
        margin-bottom: 14px;
        position: relative;
        padding-bottom: 14px;
    }
    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 46px;
        height: 3px;
        border-radius: 2px;
        background-color: var(--color-primary);
    }
    .lead { color: #5b7268; font-size: 0.95rem; line-height: 1.9; margin: 18px 0 30px; }
    .note { color: #6d857b; font-size: 0.86rem; line-height: 1.9; margin-top: 22px; }

    /* こんな方へ */
    .worries-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 30px; }
    .worry-card {
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 14px;
        padding: 26px 22px;
        text-align: center;
        box-shadow: 0 4px 14px rgba(78, 123, 103, 0.06);
    }
    .worry-icon { font-size: 1.8rem; }
    .worry-card h3 { font-size: 1.05rem; color: var(--color-text); margin: 12px 0 10px; }
    .worry-card p { font-size: 0.88rem; color: #5b7268; line-height: 1.8; margin: 0; }

    /* 基本プラン */
    .plan-list { display: grid; gap: 18px; }
    .plan-card {
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 16px;
        padding: 26px 28px;
        box-shadow: 0 4px 14px rgba(78, 123, 103, 0.06);
    }
    .plan-card.featured { border-color: var(--color-primary); box-shadow: 0 6px 20px rgba(78, 123, 103, 0.14); }
    .plan-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
    .plan-name { font-size: 1.25rem; font-weight: bold; color: var(--color-primary); }
    .plan-pages {
        display: inline-block;
        margin-left: 12px;
        font-size: 0.75rem;
        color: var(--color-accent);
        background: #eaf3ee;
        border-radius: 999px;
        padding: 3px 12px;
        vertical-align: 3px;
    }
    .plan-price { display: flex; align-items: baseline; gap: 20px; }
    .p-label { font-size: 0.7rem; color: #7d968b; margin-right: 6px; }
    .p-yen { font-size: 1.35rem; font-weight: bold; color: var(--color-text); }
    .p-member .p-yen { color: #a8792c; font-size: 1.2rem; }
    .plan-desc { color: #5b7268; font-size: 0.9rem; line-height: 1.9; margin: 16px 0 0; }

    /* 一覧行（必須・オプション・維持費） */
    .row-list { display: grid; gap: 12px; margin-top: 26px; }
    .row-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 12px;
        padding: 20px 24px;
    }
    .row-item.required { border-left: 4px solid var(--color-primary); }
    .row-body { display: flex; flex-direction: column; gap: 6px; }
    .row-name { font-weight: bold; font-size: 0.98rem; }
    .row-desc { font-size: 0.84rem; color: #6d857b; line-height: 1.8; }
    .row-price { text-align: right; white-space: nowrap; }
    .rp-main { display: block; font-size: 1.1rem; font-weight: bold; color: var(--color-text); }
    .rp-member { display: block; font-size: 0.78rem; color: #a8792c; margin-top: 4px; }
    .per { font-size: 0.7rem; color: #7d968b; margin-left: 4px; }

    .tag-req, .tag-opt {
        display: inline-block;
        margin-left: 10px;
        font-size: 0.68rem;
        border-radius: 4px;
        padding: 2px 8px;
        vertical-align: 2px;
    }
    .tag-req { background: var(--color-primary); color: #fff; }
    .tag-opt { background: #eaf3ee; color: var(--color-accent); }

    .example-box {
        margin-top: 24px;
        background: #eaf3ee;
        border-radius: 14px;
        padding: 22px 26px;
        text-align: center;
    }
    .example-box p { margin: 0; font-size: 0.92rem; line-height: 2; color: #3c5b4f; }
    .total { font-size: 1.15rem; color: var(--color-primary); }
    .ex-note { display: block; font-size: 0.78rem; color: #6d857b; }

    /* 含まれるもの */
    .include-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: 30px; }
    .include-card {
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 14px;
        padding: 24px 26px;
    }
    .include-card h3 { font-size: 1rem; color: var(--color-primary); margin: 0 0 14px; }
    .include-card.excluded h3 { color: #8a9a92; }
    .include-card ul { margin: 0; padding-left: 1.2em; }
    .include-card li { font-size: 0.88rem; color: #5b7268; line-height: 1.9; margin-bottom: 6px; }

    /* 流れ */
    .flow-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 30px; }
    .flow-card {
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 12px;
        padding: 20px;
    }
    .flow-no { font-size: 0.7rem; font-weight: bold; color: var(--color-primary); letter-spacing: 0.1em; }
    .flow-card h3 { font-size: 1rem; margin: 8px 0; }
    .flow-card p { font-size: 0.84rem; color: #6d857b; line-height: 1.8; margin: 0; }

    /* 注記 */
    .notes-card {
        background: #fff;
        border: 1px solid #e1ebe5;
        border-radius: 14px;
        padding: 26px 28px;
        margin-top: 26px;
    }
    .notes-card p { font-size: 0.88rem; color: #5b7268; line-height: 1.9; margin: 0 0 12px; }
    .notes-card p:last-child { margin-bottom: 0; }
    .notes-card strong { color: var(--color-text); }
    .tax { font-size: 0.82rem !important; color: #7d968b !important; }

    /* CTA */
    .cta-section {
        background: #eaf3ee;
        border-radius: 20px;
        padding: 46px 30px;
    }
    .cta-section h2 { color: var(--color-primary); font-size: 1.35rem; margin: 0 0 14px; }
