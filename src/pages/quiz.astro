---
import Layout from '../layouts/Layout.astro';
import LearnCta from '../components/LearnCta.astro';
import { safeFetchJson } from '../lib/safeFetch';

const apiKey = import.meta.env.NOTION_API_KEY;
const quizDbId = import.meta.env.NOTION_QUIZ_ID;

// 全件をページング取得（Notionは1回100件上限のため）
async function fetchAllQuiz() {
  if (!apiKey || !quizDbId) return [];
  let results: any[] = [];
  let cursor: string | undefined = undefined;
  for (let i = 0; i < 20; i++) {
    const body: any = { page_size: 100 };
    if (cursor) body.start_cursor = cursor;
    const data = await safeFetchJson<{ results?: any[]; has_more?: boolean; next_cursor?: string }>(
      `https://api.notion.com/v1/databases/${quizDbId}/query`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${apiKey}`,
          'Notion-Version': '2022-06-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(body),
      },
      { results: [] }
    );
    results = results.concat(data.results || []);
    if (!data.has_more || !data.next_cursor) break;
    cursor = data.next_cursor;
  }
  return results;
}
const questions = await fetchAllQuiz();

// カテゴリー別の件数（出題選択画面用）
const catCounts: Record<string, number> = {};
questions.forEach((q: any) => {
  const c = q.properties['カテゴリー']?.select?.name || 'その他';
  catCounts[c] = (catCounts[c] || 0) + 1;
});
const CAT_ORDER = ['丘（マウント）', '線（ライン）', '記号・マーク', '手の形・指', '流年・基本'];
const categories = CAT_ORDER.filter((c) => catCounts[c]);
---

<Layout title="手相クイズ | マヨネリ">
  <div class="quiz-container">
    <h1 class="page-title">手相クイズ</h1>
    <p class="page-desc">あなたの手相リテラシーをチェックしてみましょう！</p>
    
    {questions.length === 0 ? (
      <p style="text-align:center; color:#888;">現在、問題を作成中です。公開までもうしばらくお待ちください。</p>
    ) : (
      <div id="quiz-app">

        {/* カテゴリー選択（スタート画面） */}
        <div id="category-screen">
          <p class="cat-intro">挑戦するカテゴリーを選んでください（各10問・ランダム出題）</p>
          <div class="cat-grid">
            <button class="cat-btn cat-all" data-cat="all">
              🎲 すべてから出題 <span class="cat-count">{questions.length}問</span>
            </button>
            {categories.map((c) => (
              <button class="cat-btn" data-cat={c}>
                {c} <span class="cat-count">{catCounts[c]}問</span>
              </button>
            ))}
          </div>
        </div>

        {/* 🌟 一旦すべての問題を「非表示（display:none）」の状態で裏側に作っておく */}
        {questions.map((q: any, index: number) => {
          const text = q.properties['問題文']?.title[0]?.plain_text || '問題がありません';
          const op1 = q.properties['選択肢1']?.rich_text[0]?.plain_text || '';
          const op2 = q.properties['選択肢2']?.rich_text[0]?.plain_text || '';
          const op3 = q.properties['選択肢3']?.rich_text[0]?.plain_text || '';
          const op4 = q.properties['選択肢4']?.rich_text[0]?.plain_text || '';
          
          const ansProp = q.properties['正解の番号'];
          const answer = ansProp?.rich_text?.[0]?.plain_text || ansProp?.select?.name || ansProp?.number?.toString() || '1';
          
          const explanation = q.properties['解説']?.rich_text[0]?.plain_text || '解説はありません。';
          const category = q.properties['カテゴリー']?.select?.name || 'その他';

          return (
            <div class="question-card" data-category={category} style="display:none;">
              <div class="q-header">問題 <span class="current-q"></span> / <span class="total-q"></span></div>
              <h2 class="q-text">{text}</h2>
              
              <div class="options-grid">
                {op1 && <button class="option-btn" data-choice="1" data-answer={answer}><span class="choice-num">1</span> {op1}</button>}
                {op2 && <button class="option-btn" data-choice="2" data-answer={answer}><span class="choice-num">2</span> {op2}</button>}
                {op3 && <button class="option-btn" data-choice="3" data-answer={answer}><span class="choice-num">3</span> {op3}</button>}
                {op4 && <button class="option-btn" data-choice="4" data-answer={answer}><span class="choice-num">4</span> {op4}</button>}
              </div>

              <div class="explanation-area hidden">
                <div class="result-badge"></div>
                <div class="exp-box">
                  <h3 class="exp-title">【解説】</h3>
                  <p class="exp-text">{explanation}</p>
                </div>
                <button class="next-btn" data-next=""></button>
              </div>
            </div>
          );
        })}

        <div id="result-screen" class="hidden">
          <h2>お疲れ様でした！</h2>
          <p class="final-score">あなたの正解数</p>
          <div class="score-display">
            <span id="score-number">0</span><span class="score-total"> / <span id="final-total"></span></span>
          </div>
          <p id="score-message" class="score-message"></p>
          <LearnCta lead="クイズで覚えた知識を、目の前の手で使えるように。" />
          
          <div class="result-actions">
            <button onclick="window.location.reload();" class="retry-btn">別の問題に挑戦する</button>
            <a href="/kouza" class="learn-btn">講座で基礎から学ぶ</a>
            <a href="/" class="home-btn">ホームへ戻る</a>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<script is:inline data-astro-rerun>
(function () {
  var quizApp = document.getElementById('quiz-app');
  var resultScreen = document.getElementById('result-screen');
  var catScreen = document.getElementById('category-screen');
  if (!quizApp || !resultScreen) return;

  var allCards = Array.from(document.querySelectorAll('.question-card'));
  if (allCards.length === 0) return;

  resultScreen.classList.add('hidden');

  var MAX_QUESTIONS = 10;
  var currentScore = 0;
  var totalQuestions = 0;

  function startQuiz(cat) {
    var pool = allCards.filter(function (c) {
      return cat === 'all' || c.getAttribute('data-category') === cat;
    });
    if (pool.length === 0) return;

    // 一旦すべてDOMから外す
    allCards.forEach(function (c) { if (c.parentNode) c.parentNode.removeChild(c); });

    // シャッフルして最大10問
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
    }
    var selected = pool.slice(0, MAX_QUESTIONS);
    totalQuestions = selected.length;
    currentScore = 0;

    if (catScreen) catScreen.classList.add('hidden');

    selected.forEach(function (card, index) {
      card.setAttribute('data-index', String(index));
      card.style.display = 'none';
      var header = card.querySelector('.q-header');
      if (header) header.innerHTML = '問題 <span class="current-q">' + (index + 1) + '</span> / ' + totalQuestions;
      var nextBtn = card.querySelector('.next-btn');
      if (nextBtn) {
        nextBtn.setAttribute('data-next', String(index + 1));
        nextBtn.textContent = (index + 1 === totalQuestions) ? '結果を見る →' : '次の問題へ →';
      }
      quizApp.insertBefore(card, resultScreen);
    });

    selected[0].style.display = 'block';
    var finalTotalEl = document.getElementById('final-total');
    if (finalTotalEl) finalTotalEl.textContent = String(totalQuestions);

    wireHandlers();
  }

  function wireHandlers() {
    document.querySelectorAll('.option-btn').forEach(function (button) {
      button.addEventListener('click', function (e) {
        var btn = e.currentTarget;
        var card = btn.closest('.question-card');
        if (!card || card.classList.contains('answered')) return;
        card.classList.add('answered');

        var selected = btn.getAttribute('data-choice');
        var correct = btn.getAttribute('data-answer');
        var expArea = card.querySelector('.explanation-area');
        var badge = card.querySelector('.result-badge');

        card.querySelectorAll('.option-btn').forEach(function (b) {
          if (b !== btn) b.style.opacity = '0.6';
        });

        if (selected === correct) {
          btn.classList.add('correct');
          if (badge) { badge.innerHTML = '<span class="icon correct-icon">⭕</span> 正解！'; badge.className = 'result-badge correct-badge'; }
          currentScore++;
        } else {
          btn.classList.add('wrong');
          if (badge) { badge.innerHTML = '<span class="icon wrong-icon">❌</span> 不正解...'; badge.className = 'result-badge wrong-badge'; }
          var correctBtn = card.querySelector('.option-btn[data-choice="' + correct + '"]');
          if (correctBtn) correctBtn.classList.add('correct');
        }
        if (expArea) expArea.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.next-btn').forEach(function (button) {
      button.addEventListener('click', function (e) {
        var btn = e.currentTarget;
        var nextIndex = parseInt(btn.getAttribute('data-next') || '0');
        var currentCard = btn.closest('.question-card');
        if (currentCard) currentCard.style.display = 'none';

        var nextCard = document.querySelector('.question-card[data-index="' + nextIndex + '"]');
        if (nextCard) {
          nextCard.style.display = 'block';
        } else {
          resultScreen.classList.remove('hidden');
          var scoreNumber = document.getElementById('score-number');
          var scoreMessage = document.getElementById('score-message');
          if (scoreNumber) scoreNumber.textContent = String(currentScore);
          if (scoreMessage) {
            var pct = totalQuestions ? currentScore / totalQuestions : 0;
            scoreMessage.textContent = pct === 1 ? '完璧です！素晴らしい手相リテラシーです！' : pct >= 0.5 ? '良いペースです！さらに理解を深めましょう！' : '伸びしろがあります！用語集や講座を活用してみてくださいね。';
          }
        }
      });
    });
  }

  // カテゴリー選択でスタート
  document.querySelectorAll('.cat-btn').forEach(function (b) {
    b.addEventListener('click', function () { startQuiz(b.getAttribute('data-cat')); });
  });
})();
</script>

<style>
  .quiz-container { max-width: 650px; margin: 0 auto; padding: 40px 20px; }
  .page-title { text-align: center; color: var(--color-primary); font-size: 2rem; margin-bottom: 10px; }
  .page-desc { text-align: center; color: #666; margin-bottom: 40px; }

  /* カテゴリー選択画面 */
  #category-screen { text-align: center; }
  .cat-intro { color: #555; margin-bottom: 25px; font-size: 1.05rem; }
  .cat-grid { display: flex; flex-direction: column; gap: 14px; max-width: 480px; margin: 0 auto; }
  .cat-btn { display: flex; justify-content: space-between; align-items: center; background: white; border: 2px solid var(--color-primary); color: var(--color-primary); padding: 18px 24px; border-radius: 10px; font-size: 1.15rem; font-weight: bold; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
  .cat-btn:hover { background: var(--color-primary); color: white; transform: translateY(-2px); }
  .cat-btn.cat-all { background: var(--color-primary); color: white; }
  .cat-btn.cat-all:hover { opacity: 0.9; }
  .cat-count { font-size: 0.85rem; font-weight: normal; opacity: 0.85; margin-left: 12px; white-space: nowrap; }

  .question-card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
  .q-header { font-size: 1rem; color: var(--color-primary); margin-bottom: 15px; font-weight: bold; }
  .current-q, .total-q { font-size: 1.4rem; }
  .q-text { font-size: 1.3rem; margin-bottom: 25px; line-height: 1.5; color: var(--color-text); }
  
  .options-grid { display: flex; flex-direction: column; gap: 12px; }
  .option-btn { background: white; border: 2px solid #e0e0e0; padding: 15px 20px; border-radius: 8px; font-size: 1.05rem; text-align: left; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; color: var(--color-text); }
  .option-btn:hover { border-color: var(--color-primary); background: #f8fbf9; }
  .choice-num { display: inline-block; width: 24px; height: 24px; background: #eee; color: #555; text-align: center; border-radius: 50%; line-height: 24px; font-size: 0.9rem; margin-right: 15px; font-weight: bold; }
  
  .option-btn.correct { background: #e8f5e9; border-color: #4caf50; font-weight: bold; }
  .option-btn.correct .choice-num { background: #4caf50; color: white; }
  .option-btn.wrong { background: #ffebee; border-color: #f44336; }
  .option-btn.wrong .choice-num { background: #f44336; color: white; }
  
  .explanation-area { margin-top: 30px; animation: fadeIn 0.5s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
  
  .result-badge { font-size: 1.3rem; font-weight: bold; margin-bottom: 20px; padding: 15px; border-radius: 8px; text-align: center; }
  .correct-badge { background: #e8f5e9; color: #2e7d32; }
  .wrong-badge { background: #ffebee; color: #c62828; }
  .icon { margin-right: 8px; }
  
  .exp-box { background: #f9f9f9; padding: 20px; border-radius: 8px; border-left: 4px solid var(--color-primary); margin-bottom: 25px; }
  .exp-title { font-size: 1rem; color: var(--color-primary); margin: 0 0 10px 0; }
  .exp-text { line-height: 1.6; color: #444; margin: 0; white-space: pre-wrap; }
  
  .next-btn { display: block; width: 100%; padding: 16px; background: var(--color-primary); color: white; text-align: center; border: none; border-radius: 8px; font-size: 1.1rem; cursor: pointer; font-weight: bold; transition: opacity 0.2s; }
  .next-btn:hover { opacity: 0.9; }
  
  .hidden { display: none !important; }
  
  #result-screen { text-align: center; background: white; padding: 50px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
  .final-score { font-size: 1.2rem; color: #666; margin-bottom: 10px; }
  .score-display { margin-bottom: 20px; }
  #score-number { font-size: 4rem; color: var(--color-primary); font-weight: bold; line-height: 1; }
  .score-total { font-size: 1.5rem; color: #888; }
  .score-message { font-size: 1.1rem; line-height: 1.5; color: var(--color-text); margin-bottom: 40px; }
  
  .result-actions { display: flex; flex-direction: column; gap: 15px; }
  .retry-btn, .learn-btn, .home-btn { display: block; padding: 15px; border-radius: 8px; font-size: 1.1rem; font-weight: bold; text-decoration: none; transition: opacity 0.2s; cursor: pointer; text-align: center; }
  .retry-btn { border: 2px solid var(--color-primary); color: var(--color-primary); background: white; }
  .learn-btn { background: var(--color-primary); color: white; }
  .home-btn { background: #eef2f5; color: #555; border: 1px solid #dcdcdc; }
  .retry-btn:hover, .learn-btn:hover, .home-btn:hover { opacity: 0.8; }
</style>