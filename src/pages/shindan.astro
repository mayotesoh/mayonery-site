    s += `<text x="${CX}" y="${CY+QR+18}" text-anchor="middle" fill="var(--color-text)" font-size="10" opacity="0.6">現実的・論理</text>`;
    s += `<text x="${CX+QR+6}" y="${CY+4}" text-anchor="start" fill="var(--color-text)" font-size="10" opacity="0.6">動的</text>`;
    s += `<text x="${CX-QR-6}" y="${CY+4}" text-anchor="end"   fill="var(--color-text)" font-size="10" opacity="0.6">静的</text>`;

    s += `<line x1="${ydx}" y1="${ydy}" x2="${pdx}" y2="${pdy}" stroke="#7a9487" stroke-width="2" opacity="0.5" stroke-dasharray="5,5"/>`;

    s += `<circle cx="${ydx}" cy="${ydy}" r="12" fill="#2b6cb0" opacity="0.2"/>`;
    s += `<circle cx="${ydx}" cy="${ydy}" r="6" fill="#2b6cb0" stroke="#fff" stroke-width="1.5"/>`;
    s += `<circle cx="${pdx}" cy="${pdy}" r="12" fill="#d9467d" opacity="0.2"/>`;
    s += `<circle cx="${pdx}" cy="${pdy}" r="6" fill="#d9467d" stroke="#fff" stroke-width="1.5"/>`;
    s += `</svg>`;
    return s;
  }

