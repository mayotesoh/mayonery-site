    const fig = el('sd-figure');
    fig.innerHTML = `<img src="/shindan/${Q.img}.webp" alt="${Q.q}" width="800" height="450" decoding="async">`;
    // 次の問いの画像を先読みしておく（押した瞬間に出るように）
    const nx = QUESTIONS[qi + 1];
    if (nx) { const pre = new Image(); pre.src = `/shindan/${nx.img}.webp`; }
    const box = el('sd-choices');
    box.innerHTML = '';
    // 画像は選択肢が横に並んでいるので、ボタンも同じ列数にして対応を取る
    box.dataset.cols = String(Q.choices.length);
    Q.choices.forEach(([label, val]) => {
