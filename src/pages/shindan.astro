  // ── 2人用：性格マトリクス ──
  function buildPairQuadrant(yX, yY, pX, pY) {
    const W = 380, H = 380, CX = 190, CY = 190, QR = 145;
    const ydx = (CX + yX / 50 * QR).toFixed(1), ydy = (CY - yY / 50 * QR).toFixed(1);
    const pdx = (CX + pX / 50 * QR).toFixed(1), pdy = (CY - pY / 50 * QR).toFixed(1);

