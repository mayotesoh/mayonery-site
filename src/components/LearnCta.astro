---
// 用語集・クイズ・ブログの末尾に置く「全7章セット」への導線
export interface Props {
  lead?: string;
}
const { lead = '覚えた線の意味を、目の前の手で使えるように。' } = Astro.props;
---

<aside class="learn-cta">
  <p class="learn-cta__lead">{lead}</p>
  <p class="learn-cta__body">線を「拾う」力と、読み取った情報を「扱う」力を、全7章の動画で学べる講座があります。講師への1対1の質問つき。</p>
  <a class="learn-cta__link" href="/lp/tesou-video/" data-astro-reload>手相講座 全7章セットを見る →</a>
</aside>

<style>
  .learn-cta { margin: 48px 0 8px; padding: 24px 26px; background: #fff; border: 1px solid #e1ebe5; border-left: 4px solid var(--color-primary); border-radius: 0 10px 10px 0; text-align: left; }
  .learn-cta__lead { margin: 0 0 8px; font-weight: bold; font-size: 1.05rem; color: var(--color-text); }
  .learn-cta__body { margin: 0 0 14px; font-size: 0.95rem; line-height: 1.8; color: #555; }
  .learn-cta__link { font-weight: bold; color: var(--color-primary); text-decoration: none; }
  .learn-cta__link:hover { text-decoration: underline; }
</style>
